    "@aws-sdk/client-sns": "^3.1089.0",
    "axios": "^1.18.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "mailparser": "^3.9.14",
    "postgres": "^3.4.9",
    "uuid": "^14.0.1"
  }
